# AWS Configuration
aws_region = "us-east-1"

# Project Configuration
project_name = "my-eks-project"
environment  = "dev"

# VPC Configuration
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
availability_zone   = "us-east-1a"

# EKS Cluster Configuration
cluster_name       = "my-eks-cluster"
kubernetes_version = "1.30"

# Node Group Configuration - USER PARAMETERS
instance_type           = "t3.medium"     # Options: t3.small, t3.medium, t3.large, m5.large, m5.xlarge, etc.
node_group_min_size     = 2               # Minimum number of nodes
node_group_max_size     = 5               # Maximum number of nodes
node_group_desired_size = 2               # Desired number of nodes
node_group_disk_size    = 20              # Disk size in GB

# Common Tags
common_tags = {
  Terraform   = "true"
  Project     = "EKS"
  ManagedBy   = "Terraform"
  Environment = "dev"
  CostCenter  = "engineering"
}
